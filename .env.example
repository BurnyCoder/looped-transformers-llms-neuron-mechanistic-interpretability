# Copy to .env and edit. Loaded by src/loopneuron/config.py via python-dotenv.
# --- Looped LM under study (Ouro-1.4B, https://huggingface.co/ByteDance/Ouro-1.4B) ---
MODEL_ID=ByteDance/Ouro-1.4B
MODEL_REVISION=574fa66cb8bf5abdc979642d01cf2b79b16bfab1
REPLICATION_MODEL_ID=ByteDance/Ouro-1.4B-Thinking
REPLICATION_MODEL_REVISION=3aaa2224253a92ca45cf2e3d427c360e1ef9c93d
UT_STEPS=4
# --- Atlas (activation statistics) ---
ATLAS_TOKENS=8000000
SEQ_LEN=256
ATLAS_BATCH=16
TOPK=40
TOPK_PER_LOOP=20
MATH_FRACTION=0.1
# --- Steering experiments ---
SEED=1234
GEN_TOKENS=48
SAMPLES_PER_PROMPT=3
NULL_NEURONS=100
# --- Local labeler/judge LLM served by llama.cpp llama-server (OpenAI-compatible API) ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3.5-9b
# --- Safety margin for downloads (GB of free disk that must remain) ---
MIN_FREE_GB=3
